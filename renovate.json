{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>meenzen/renovate-config"
  ],
  "ignorePresets": [
    ":ignoreModulesAndTests"
  ],
  "forkProcessing": "enabled",
  "packageRules": [
    {
      "description": "Microsoft.Extensions.* and System.Text.Json 11.x don't support net8.0/net9.0, see Directory.Packages.props",
      "matchDatasources": ["nuget"],
      "matchPackageNames": ["Microsoft.Extensions.*", "System.Text.Json", "System.Net.Http.Json"],
      "matchCurrentVersion": "/^10\\./",
      "allowedVersions": "<11.0.0"
    }
  ]
}
